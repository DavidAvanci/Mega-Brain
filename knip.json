{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["server/main.ts", "vitest.config.ts", "scripts/commands/*.{ts,mjs}", "**/*.test.{ts,tsx,mjs}"],
  "project": ["src/**/*.{ts,tsx}", "server/**/*.ts", "scripts/**/*.{ts,mjs}", "*.ts", "*.mjs"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "ignoreDependencies": ["@vitest/coverage-v8"],
  "vite": true,
  "vitest": false
}
