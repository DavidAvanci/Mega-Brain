{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../dist/server/main.mjs": "server/main.mjs",
      "../dist/server/smart-diff-review-cli.mjs": "server/smart-diff-review-cli.mjs",
      "target/mega-brain-runtime/node": "runtime/node",
      "target/mega-brain-runtime/activity-island": "runtime/activity-island"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mega Brain",
        "width": 1280,
        "height": 820,
        "fullscreen": false,
        "maximized": false,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 25
        },
        "shadow": true
      }
    ]
  }
}
