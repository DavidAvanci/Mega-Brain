{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mega Brain",
  "version": "0.1.0",
  "identifier": "com.megabrain.desktop",
  "build": {
    "beforeBuildCommand": "npm run build && npm run server:build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:15173"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'none'; worker-src 'none'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
    },
    "windows": [
      {
        "label": "main",
        "title": "Mega Brain",
        "width": 1440,
        "height": 940,
        "fullscreen": false,
        "maximized": true,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Quadro local para organizar e executar trabalho assistido.",
    "copyright": "Copyright © 2026 Mega Brain",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Mega Brain",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
