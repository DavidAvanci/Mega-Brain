+import React, { useState } from 'react';
+import { FiTrendingUp } from 'react-icons/fi';
+import { Button, IconClose, Modal } from 'takeat-design-system-ui-kit';
+import { useAuth } from '~/context/AuthContext';
+import {
+  Container,
+  IconCircle,
+  TextArea,
+  Title,
+  Message,
+  CloseButton,
+  VideoList,
+  VideoItem,
+  VideoThumb,
+  VideoInfo,
+} from './styles';
+
+const STORAGE_KEY = '@gddashboard:banner_nova_opr:v1';
+
+const NOVA_OPR_VIDEOS = [
+  {
+    title: 'Fluxo de Pedidos',
+    url: 'https://youtu.be/9u-Vuj38UJU',
+    youtubeId: '9u-Vuj38UJU',
+  },
+  {
+    title: 'Fluxo de Vendas no Modo Balcão',
+    url: 'https://youtu.be/U4ZDapJzNGg',
+    youtubeId: 'U4ZDapJzNGg',
+  },
+  {
+    title: 'Conferência de Caixa',
+    url: 'https://youtu.be/ZWY5NA0foMY',
+    youtubeId: 'ZWY5NA0foMY',
+  },
+  {
+    title: 'Pagamento de Mesas e Comandas',
+    url: 'https://youtu.be/am8Uvf86ECk',
+    youtubeId: 'am8Uvf86ECk',
+  },
+];
+
+export function BannerNovaOpr() {
+  const { user } = useAuth();
+  const [dismissed, setDismissed] = useState(
+    localStorage.getItem(STORAGE_KEY) === 'true'
+  );
+  const [isModalOpen, setIsModalOpen] = useState(false);
+
+  if (dismissed || !user || user.use_new_operation) return null;
+
+  const toggleModal = () => setIsModalOpen((state) => !state);
+
+  const handleClose = () => {
+    localStorage.setItem(STORAGE_KEY, 'true');
+    setDismissed(true);
+  };
+
+  return (
+    <Container>
+      <IconCircle>
+        <FiTrendingUp size={20} color="#FFA814" />
+      </IconCircle>
+      <TextArea>
+        <Title>Seu PDV está evoluindo!</Title>
+        <Message>
+          Nos próximos dias, seu sistema receberá automaticamente uma nova
+          interface, <strong>sem nenhum custo adicional</strong>. Ela foi
+          criada para deixar sua operação mais simples, intuitiva e eficiente,
+          com melhorias de usabilidade e novos recursos.
+        </Message>
+      </TextArea>
+      <Button
+        type="button"
+        customColor="#FFA814"
+        style={{ flexShrink: 0, borderRadius: 20 }}
+        onClick={toggleModal}
+      >
+        Conheça as novidades
+      </Button>
+      <CloseButton
+        type="button"
+        aria-label="Fechar aviso"
+        onClick={handleClose}
+      >
+        <IconClose fontSize={20} fill="#3D3D3D" />
+      </CloseButton>
+
+      <Modal
+        open={isModalOpen}
+        toggle={toggleModal}
+        style={{ maxWidth: 520, width: '92%', height: 'auto' }}
+      >
+        <Modal.Header hasClose>Conheça a nova operação Takeat</Modal.Header>
+        <Modal.Body>
+          <VideoList>
+            {NOVA_OPR_VIDEOS.map((video) => (
+              <VideoItem
+                key={video.youtubeId}
+                href={video.url}
+                target="_blank"
+                rel="noopener noreferrer"
+              >
+                <VideoThumb
+                  src={`https://img.youtube.com/vi/${video.youtubeId}/mqdefault.jpg`}
+                  alt={video.title}
+                />
+                <VideoInfo>
+                  <strong>{video.title}</strong>
+                  <span>Assistir no YouTube</span>
+                </VideoInfo>
+              </VideoItem>
+            ))}
+          </VideoList>
+        </Modal.Body>
+      </Modal>
+    </Container>
+  );
+}
