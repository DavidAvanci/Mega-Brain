{
  "name": "mega-brain",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "card:create": "tsx scripts/commands/create-card.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode:report": "knip --no-exit-code",
    "deadcode:production": "knip --config knip.production.json --production --strict --no-exit-code",
    "coverage": "vitest run --coverage",
    "quality": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "server:dev": "node scripts/commands/server-dev.mjs",
    "server:build": "node scripts/commands/server-build.mjs",
    "server:test": "vitest run server",
    "server:benchmark-readiness": "node scripts/commands/measure-backend-readiness.mjs",
    "tauri:dev": "node scripts/commands/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "card-triage:evaluate": "tsx scripts/commands/evaluate-card-triage.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@git-diff-view/react": "^0.1.7",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "marked": "^18.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.1",
    "knip": "^5.88.1",
    "prettier": "^3.9.8",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
