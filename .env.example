# Jira: use apenas o identificador do site (ex.: exemplo para exemplo.atlassian.net)
JIRA_SITE=example
JIRA_EMAIL=usuario@example.invalid
JIRA_API_TOKEN=replace-with-your-jira-api-token

# Caminho para um repositório de exemplo relativo ao app
AGENT_REPOS=../sample-project

# Diretório local dos cards
WORKSPACE_DIR=/home/usuario/mega-brain-files/workspace

# Triagem de cards com Jev (TypeSafe); habilite em Configurações.
TYPESAFE_API_KEY=
# Opcional; padrão https://api.typesafe.ai
TYPESAFE_BASE_URL=
